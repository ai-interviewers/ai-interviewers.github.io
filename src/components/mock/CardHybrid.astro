---
/*
 * Round 2 card. One component for every Round 2 direction — they differ only in tokens
 * and ornament, so the structure below is the agreed structure:
 *
 *   · Title, author, year, and venue are always present, in both tile and list view.
 *   · Venue sits top-right, as in direction D's slug line.
 *   · No tags or classification badges — those live in the filters only.
 *   · Thumbnails appear in tile view.
 *
 * Built on direction C's compact, tabular base.
 */
import { dataAttrs, firstAuthor, shortVenue, year } from '../../lib/papers';
import type { Paper } from '../../lib/papers';

const { paper } = Astro.props as { paper: Paper };
const d = paper.data;
const abstract = paper.body ?? '';
const initials = d.title
  .replace(/[^A-Za-z ]/g, '')
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
---

<article class="card-h" {...dataAttrs(paper)}>
  <a class="thumb" href={d.url} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
    {
      d.thumbnail ? (
        <img src={d.thumbnail} alt="" loading="lazy" width="710" height="290" />
      ) : (
        <span class="thumb-fallback">{initials}</span>
      )
    }
  </a>

  <div class="body">
    <header class="slug">
      <span class="yr">{year(paper)}</span>
      <span class="venue">{shortVenue(paper)}</span>
    </header>

    <h3 class="title">
      <a href={d.url} target="_blank" rel="noopener">{d.title}</a>
    </h3>

    <p class="authors">{firstAuthor(paper)}</p>

    <p class="abstract">{abstract.slice(0, 190)}{abstract.length > 190 ? '…' : ''}</p>
  </div>
</article>

<style>
  .card-h {
    display: flex;
    flex-direction: column;
    background: var(--color-panel);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .card-h:hover {
    border-color: var(--color-accent);
  }

  .thumb {
    display: block;
    aspect-ratio: 71 / 29;
    overflow: hidden;
    background: var(--color-accent-soft);
    border-bottom: 1px solid var(--color-rule);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .thumb-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-ink);
    opacity: 0.22;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.75rem 0.9rem 0.9rem;
  }

  /* Year left, venue right — D's slug line. */
  .slug {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .yr,
  .venue {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .yr {
    font-weight: 700;
    color: var(--color-ink);
  }

  .venue {
    color: var(--color-ink-muted);
    text-align: right;
  }

  .title {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.01em;
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .authors {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  .abstract {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    line-height: 1.58;
    color: var(--color-ink-muted);
  }

  /* ---------- list view: a ledger row, still carrying all four fields ---------- */
  :global([data-view='list']) .card-h {
    display: block;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-rule);
    border-radius: 0;
  }

  :global([data-view='list']) .card-h:hover {
    background: var(--color-accent-soft);
  }

  :global([data-view='list']) .thumb,
  :global([data-view='list']) .abstract {
    display: none;
  }

  :global([data-view='list']) .body {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) 10rem 7.5rem;
    gap: 0 1rem;
    align-items: baseline;
    padding: 0.5rem 0.6rem;
  }

  :global([data-view='list']) .slug {
    display: contents;
  }

  :global([data-view='list']) .title {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 500;
  }

  :global([data-view='list']) .authors {
    margin: 0;
    font-size: 0.76rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Venue is last in the grid, so it lands hard right. */
  :global([data-view='list']) .venue {
    order: 4;
  }

  @media (max-width: 700px) {
    :global([data-view='list']) .body {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    :global([data-view='list']) .authors,
    :global([data-view='list']) .venue {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
