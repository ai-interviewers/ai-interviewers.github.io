---
/*
 * Shared card for Round 2 and 3. Structure is settled:
 *
 *   · Title, all authors, year, and venue are always present, in tile and list view.
 *   · Venue top-right, as in direction D's slug line.
 *   · No tags or classification badges — those live in the filters only.
 *   · Thumbnails in tile view.
 *   · Abstract hidden behind an expander rather than shown by default.
 *   · The whole card opens the paper in a new tab.
 */
import { dataAttrs, shortVenue, year } from '../../lib/papers';
import type { Paper } from '../../lib/papers';

const { paper } = Astro.props as { paper: Paper };
const d = paper.data;
const abstract = paper.body?.trim() ?? '';
const authors = d.authors.join(', ');
const initials = d.title
  .replace(/[^A-Za-z ]/g, '')
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
---

<article
  class="card-h"
  {...dataAttrs(paper)}
  style={`--yr-color: var(--yr-${year(paper)}, var(--color-highlight))`}
>
  <a class="thumb" href={d.url} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
    {
      d.thumbnail ? (
        <img src={d.thumbnail} alt="" loading="lazy" width="710" height="290" />
      ) : (
        <span class="thumb-fallback">{initials}</span>
      )
    }
  </a>

  <div class="body">
    <header class="slug">
      <span class="yr">{year(paper)}</span>
      <span class="venue" title={d.venue ?? undefined}>{shortVenue(paper)}</span>
    </header>

    <h3 class="title">
      <a href={d.url} target="_blank" rel="noopener">{d.title}</a>
    </h3>

    <p class="authors" title={authors}>{authors}</p>

    {
      abstract && (
        <details class="abstract-toggle">
          <summary>Abstract</summary>
          <p class="abstract">{abstract}</p>
        </details>
      )
    }
  </div>
</article>

<style>
  .card-h {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-panel);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .card-h:hover {
    border-color: var(--color-accent);
  }

  .thumb {
    display: block;
    aspect-ratio: 71 / 29;
    overflow: hidden;
    background: var(--color-accent-soft);
    border-bottom: 1px solid var(--color-rule);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .thumb-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-ink);
    opacity: 0.22;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.75rem 0.9rem 0.85rem;
  }

  .slug {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .yr,
  .venue {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  /* Highlighter swipe on the year; the colour can vary by year. */
  .yr {
    flex: none;
    padding: 0.05rem 0.32rem;
    background: var(--yr-color);
    font-weight: 700;
    color: var(--color-ink);
  }

  /*
   * No text-transform here: acronyms like CHI and EMNLP are already capitalised in the
   * data, and forcing uppercase turned "Preprint" into shouting.
   */
  .venue {
    overflow: hidden;
    color: var(--color-ink-muted);
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .title {
    margin: 0.45rem 0 0;
    font-family: var(--font-display);
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.01em;
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /*
   * Stretched link: the whole card opens the paper. The abstract expander is lifted above
   * it so it stays independently clickable.
   */
  .title a::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: '';
  }

  .authors {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .abstract-toggle {
    position: relative;
    z-index: 2;
    margin-top: 0.6rem;
  }

  .abstract-toggle summary {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
    padding: 0.12rem 0.45rem 0.12rem 0.3rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .abstract-toggle summary::-webkit-details-marker {
    display: none;
  }

  .abstract-toggle summary::before {
    content: '+';
    font-weight: 700;
  }

  .abstract-toggle[open] summary::before {
    content: '−';
  }

  .abstract-toggle summary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .abstract {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* ---------- list view: a ledger row, still carrying all four fields ---------- */
  :global([data-view='list']) .card-h {
    display: block;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-rule);
    border-radius: 0;
  }

  :global([data-view='list']) .card-h:hover {
    background: var(--color-accent-soft);
  }

  :global([data-view='list']) .thumb,
  :global([data-view='list']) .abstract-toggle {
    display: none;
  }

  :global([data-view='list']) .body {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr) 12rem 8rem;
    gap: 0 1rem;
    align-items: baseline;
    padding: 0.45rem 0.6rem;
  }

  :global([data-view='list']) .slug {
    display: contents;
  }

  :global([data-view='list']) .title {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 500;
  }

  :global([data-view='list']) .authors {
    margin: 0;
    overflow: hidden;
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global([data-view='list']) .venue {
    order: 4;
  }

  @media (max-width: 760px) {
    :global([data-view='list']) .body {
      grid-template-columns: 3.4rem minmax(0, 1fr);
    }

    :global([data-view='list']) .authors,
    :global([data-view='list']) .venue {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
