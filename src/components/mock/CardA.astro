---
// Direction A — Academic archive. Reads like a well-kept annotated bibliography:
// serif, hairline rules, citation-forward, no imagery competing with the text.
import { dataAttrs, firstAuthor, formatDate, isUnconfirmed, label, shortVenue } from '../../lib/papers';
import type { Paper } from '../../lib/papers';

const { paper } = Astro.props as { paper: Paper };
const d = paper.data;
const abstract = paper.body ?? '';
---

<article class="card-a" {...dataAttrs(paper)}>
  <header class="head">
    <h3 class="title">
      <a href={d.url} target="_blank" rel="noopener">{d.title}</a>
    </h3>
    <p class="cite">
      {firstAuthor(paper)} · <span class="venue">{shortVenue(paper)}</span> · {formatDate(d.date)}
    </p>
  </header>

  <p class="abstract">{abstract.slice(0, 260)}{abstract.length > 260 ? '…' : ''}</p>

  <footer class="meta">
    {
      d.autonomy && (
        <span class="tag" class:list={[{ unconfirmed: isUnconfirmed(paper, 'autonomy') }]}>
          {label(d.autonomy)}
        </span>
      )
    }
    {
      d.paperType.map((t) => (
        <span class="tag" class:list={[{ unconfirmed: isUnconfirmed(paper, 'paperType') }]}>
          {label(t)}
        </span>
      ))
    }
    {
      d.domains.map((t) => (
        <span class="tag domain" class:list={[{ unconfirmed: isUnconfirmed(paper, 'domains') }]}>
          {t}
        </span>
      ))
    }
  </footer>
</article>

<style>
  .card-a {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .cite {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .venue {
    font-style: normal;
  }

  .abstract {
    margin: 0.7rem 0 0;
    max-width: 68ch;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .tag {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-rule);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
    text-transform: uppercase;
  }

  .tag.domain {
    text-transform: lowercase;
    letter-spacing: 0;
    font-variant: small-caps;
  }

  /* Provenance stays visible: a value no human has confirmed looks provisional. */
  .tag.unconfirmed {
    border-style: dashed;
    opacity: 0.72;
  }

  /* List view: drop the abstract, tighten to one line per paper. */
  :global([data-view='list']) .card-a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0 1rem;
    padding: 0.55rem 0;
  }

  :global([data-view='list']) .abstract,
  :global([data-view='list']) .meta {
    display: none;
  }

  :global([data-view='list']) .title {
    font-size: 0.95rem;
    font-weight: 500;
  }

  :global([data-view='list']) .cite {
    margin: 0;
    font-size: 0.78rem;
    text-align: right;
    white-space: nowrap;
  }
</style>
