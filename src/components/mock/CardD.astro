---
// Direction D — Transcript / stationery. Each motif has a transcript analogue, so the
// styling carries meaning rather than decorating: the mono header is a transcript
// header, the dashed rules are form fields, unconfirmed values are unfilled fields,
// and the corners carry crop marks like a printed, filed document.
import { dataAttrs, firstAuthor, isUnconfirmed, label, shortVenue } from '../../lib/papers';
import type { Paper } from '../../lib/papers';

const { paper } = Astro.props as { paper: Paper };
const d = paper.data;
const abstract = paper.body ?? '';

// Reads as a transcript slug line: 00:00 · MODALITY · AUTONOMY
const SPEAKER: Record<string, string> = {
  autonomous: 'AI INTERVIEWER',
  'ai-assisted': 'AI + HUMAN',
  both: 'AI / HUMAN',
  'not-applicable': 'HUMAN-LED',
};
---

<article class="card-d" {...dataAttrs(paper)}>
  <span class="crop tl" aria-hidden="true"></span>
  <span class="crop br" aria-hidden="true"></span>

  <header class="slug">
    <span class="speaker" class:list={[{ unconfirmed: isUnconfirmed(paper, 'autonomy') }]}>
      [{d.autonomy ? SPEAKER[d.autonomy] : 'UNCLASSIFIED'}]
    </span>
    <span class="stamp">{shortVenue(paper)}</span>
  </header>

  <h3 class="title">
    <a href={d.url} target="_blank" rel="noopener">{d.title}</a>
  </h3>

  <p class="byline">
    <span class="q">Q</span>
    {firstAuthor(paper)}
    <span class="date">{d.date.toISOString().slice(0, 10)}</span>
  </p>

  <p class="abstract">{abstract.slice(0, 240)}{abstract.length > 240 ? '…' : ''}</p>

  <footer class="strip">
    {
      d.paperType.map((t) => (
        <span class="field" class:list={[{ unconfirmed: isUnconfirmed(paper, 'paperType') }]}>
          {label(t)}
        </span>
      ))
    }
    {
      d.domains.map((t) => (
        <span class="hatch" class:list={[{ unconfirmed: isUnconfirmed(paper, 'domains') }]}>{t}</span>
      ))
    }
  </footer>
</article>

<style>
  .card-d {
    position: relative;
    padding: 1.1rem 1.2rem 1rem;
    background: var(--color-panel);
    border: 1px dashed var(--color-rule);
  }

  .card-d:hover {
    border-color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  /* Crop / registration marks — the "printed and filed" cue. */
  .crop {
    position: absolute;
    width: 7px;
    height: 7px;
    opacity: 0.55;
  }

  .crop.tl {
    top: -1px;
    left: -1px;
    border-top: 1px solid var(--color-ink);
    border-left: 1px solid var(--color-ink);
  }

  .crop.br {
    right: -1px;
    bottom: -1px;
    border-right: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }

  .slug {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--color-rule);
  }

  .speaker,
  .stamp,
  .date,
  .q {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .speaker {
    font-weight: 700;
    color: var(--color-ink);
  }

  .speaker.unconfirmed {
    color: var(--color-ink-muted);
    text-decoration: underline dashed 1px;
    text-underline-offset: 3px;
  }

  .stamp {
    color: var(--color-ink-muted);
  }

  .title {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .title a:hover {
    background: var(--color-highlight);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: baseline;
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  /* Speaker prefix, as in a transcript line. */
  .q {
    padding: 0.05rem 0.25rem;
    background: var(--color-ink);
    color: var(--color-panel);
    font-weight: 700;
  }

  .date {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .abstract {
    margin: 0.7rem 0 0;
    font-size: 0.83rem;
    line-height: 1.62;
    color: var(--color-ink-muted);
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--color-rule);
  }

  .field {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /*
   * An unconfirmed value renders as an unfilled form field — the dataset's biggest
   * weakness becomes a coherent part of the visual idea rather than a gap.
   */
  .field.unconfirmed {
    border-style: dashed;
    border-color: var(--color-rule);
    color: var(--color-ink-muted);
  }

  .hatch {
    position: relative;
    padding: 0.1rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-ink);
  }

  /* Highlighter / redaction pass over the tag. */
  .hatch::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: repeating-linear-gradient(
      -55deg,
      var(--color-hatch) 0,
      var(--color-hatch) 1px,
      transparent 1px,
      transparent 4px
    );
    content: '';
  }

  .hatch.unconfirmed::before {
    opacity: 0.45;
  }

  /* List view: collapses to a ruled ledger line. */
  :global([data-view='list']) .card-d {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: 0 1rem;
    align-items: baseline;
    padding: 0.5rem 0.7rem;
    border: 0;
    border-bottom: 1px dashed var(--color-rule);
  }

  :global([data-view='list']) .crop,
  :global([data-view='list']) .abstract,
  :global([data-view='list']) .strip {
    display: none;
  }

  :global([data-view='list']) .slug {
    padding: 0;
    border: 0;
  }

  :global([data-view='list']) .stamp {
    display: none;
  }

  :global([data-view='list']) .title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }

  :global([data-view='list']) .byline {
    margin: 0;
    font-size: 0.72rem;
  }

  :global([data-view='list']) .q {
    display: none;
  }
</style>
