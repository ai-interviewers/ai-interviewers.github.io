---
// Direction B — Modern research lab. The familiar arXiv-adjacent tool-site look:
// soft-shadowed cards, PDF thumbnail up top, pill chips, generous whitespace.
import { dataAttrs, firstAuthor, formatDate, isUnconfirmed, label, shortVenue } from '../../lib/papers';
import type { Paper } from '../../lib/papers';

const { paper } = Astro.props as { paper: Paper };
const d = paper.data;
const abstract = paper.body ?? '';
const initials = d.title.replace(/[^A-Za-z ]/g, '').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---

<article class="card-b" {...dataAttrs(paper)}>
  <a class="thumb" href={d.url} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
    {
      d.thumbnail ? (
        <img src={d.thumbnail} alt="" loading="lazy" width="800" height="330" />
      ) : (
        /* No open PDF for this paper — a typographic card keeps the grid even. */
        <span class="thumb-fallback">{initials}</span>
      )
    }
  </a>

  <div class="body">
    <p class="kicker">{shortVenue(paper)} · {formatDate(d.date)}</p>
    <h3 class="title">
      <a href={d.url} target="_blank" rel="noopener">{d.title}</a>
    </h3>
    <p class="authors">{firstAuthor(paper)}</p>
    <p class="abstract">{abstract.slice(0, 180)}{abstract.length > 180 ? '…' : ''}</p>

    <div class="chips">
      {
        d.autonomy && (
          <span class="chip accent" class:list={[{ unconfirmed: isUnconfirmed(paper, 'autonomy') }]}>
            {label(d.autonomy)}
          </span>
        )
      }
      {
        d.paperType.map((t) => (
          <span class="chip" class:list={[{ unconfirmed: isUnconfirmed(paper, 'paperType') }]}>
            {label(t)}
          </span>
        ))
      }
      {
        d.domains.slice(0, 2).map((t) => (
          <span class="chip subtle" class:list={[{ unconfirmed: isUnconfirmed(paper, 'domains') }]}>
            {t}
          </span>
        ))
      }
    </div>
  </div>
</article>

<style>
  .card-b {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-panel);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    box-shadow: 0 1px 2px rgb(16 24 40 / 6%), 0 8px 20px -12px rgb(16 24 40 / 14%);
    transition: box-shadow 160ms, transform 160ms;
  }

  .card-b:hover {
    transform: translateY(-2px);
    box-shadow: 0 2px 4px rgb(16 24 40 / 8%), 0 16px 32px -16px rgb(16 24 40 / 22%);
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: var(--color-accent-soft);
    border-bottom: 1px solid var(--color-rule);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .thumb-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    opacity: 0.5;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1rem 1.1rem 1.1rem;
  }

  .kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .title {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.011em;
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--color-accent);
  }

  .authors {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  .abstract {
    margin: 0.55rem 0 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.9rem;
  }

  .chip {
    padding: 0.15rem 0.55rem;
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-ink-muted);
  }

  .chip.accent {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .chip.subtle {
    background: transparent;
    border: 1px solid var(--color-rule);
  }

  .chip.unconfirmed {
    border: 1px dashed color-mix(in srgb, var(--color-ink) 28%, transparent);
    background: transparent;
  }

  /* List view: thumbnail becomes a small square, layout goes horizontal. */
  :global([data-view='list']) .card-b {
    flex-direction: row;
    align-items: stretch;
    border-radius: 8px;
    box-shadow: none;
  }

  :global([data-view='list']) .card-b:hover {
    transform: none;
    border-color: var(--color-accent);
  }

  :global([data-view='list']) .thumb {
    flex: 0 0 84px;
    aspect-ratio: auto;
    border-right: 1px solid var(--color-rule);
    border-bottom: 0;
  }

  :global([data-view='list']) .body {
    padding: 0.6rem 0.9rem;
  }

  :global([data-view='list']) .abstract,
  :global([data-view='list']) .chips {
    display: none;
  }

  :global([data-view='list']) .title {
    margin-top: 0.15rem;
    font-size: 0.92rem;
  }
</style>
