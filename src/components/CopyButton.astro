---
/*
 * Copy-to-clipboard button, reused for the benchmark citation and per-paper BibTeX.
 * The click handler is a single document-level delegate rather than one listener per
 * button — Astro dedupes identical inline scripts across instances, so this ships once
 * per page no matter how many CopyButtons are on it.
 */
interface Props {
  text: string;
  label?: string;
}

const { text, label = 'Copy' } = Astro.props;
---

<button type="button" class="copy-btn" data-copy={text}>
  {label}
</button>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
    if (!btn) return;
    const text = btn.dataset.copy ?? '';
    const original = btn.textContent;
    const flash = (msg: string) => {
      btn.textContent = msg;
      btn.disabled = true;
      setTimeout(() => {
        btn.textContent = original;
        btn.disabled = false;
      }, 1500);
    };
    // .catch matters: a denied clipboard permission would otherwise leave the button
    // silently stuck on its original label with no feedback at all.
    navigator.clipboard.writeText(text).then(
      () => flash('Copied'),
      () => flash('Copy failed'),
    );
  });
</script>

<style>
  .copy-btn {
    padding: 0.3rem 0.7rem;
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    cursor: pointer;
  }

  .copy-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .copy-btn:disabled {
    color: var(--color-accent);
    cursor: default;
  }
</style>
