---
// Phase 2 mockups only. Deleted once a direction is chosen; nothing here ships.
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/anybody';
import '@fontsource-variable/dm-sans';
import '@fontsource/space-mono';
import '@fontsource-variable/roboto';
import '../styles/mockups.css';
import '../styles/round2.css';
import '../styles/round3.css';

interface Props {
  variant: 'a' | 'b' | 'c' | 'd' | 'e' | 'f' | 'g' | 'h' | 'i' | 'j';
  name: string;
  eyebrow: string;
  lede: string;
  palette?: string;
  /** Round 2 only. Starting texture strength; adjustable on the page. */
  texture?: 'none' | 'subtle' | 'medium' | 'strong';
  /** Round 3 only. Starting year-highlight scheme; adjustable on the page. */
  yearPalette?: 'amber' | 'spectrum' | 'marker' | 'single';
}

const {
  variant,
  name,
  eyebrow,
  lede,
  palette,
  texture = 'medium',
  yearPalette = 'amber',
} = Astro.props;

const ROUND_3 = [
  { id: 'i', label: 'I · Light index card' },
  { id: 'j', label: 'J · Personal site' },
];

const ROUND_2 = [
  { id: 'e', label: 'E' },
  { id: 'f', label: 'F' },
  { id: 'g', label: 'G' },
  { id: 'h', label: 'H' },
];

const ROUND_1 = [
  { id: 'a', label: 'A' },
  { id: 'b', label: 'B' },
  { id: 'c', label: 'C' },
  { id: 'd', label: 'D' },
];

const round = ROUND_3.some((d) => d.id === variant)
  ? '3'
  : ROUND_2.some((d) => d.id === variant)
    ? '2'
    : '1';

const YEAR_PALETTES = [
  { id: 'amber', label: 'Amber ramp' },
  { id: 'spectrum', label: 'Cool→warm' },
  { id: 'marker', label: 'Marker pack' },
  { id: 'single', label: 'Single' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Mockup {variant.toUpperCase()} — {name}</title>
  </head>
  <body
    data-variant={variant}
    data-palette={palette}
    data-round={round}
    data-texture={round === '2' ? texture : undefined}
    data-yearpalette={round === '3' ? yearPalette : undefined}
  >
    <div class="mock-page">
      <header class="mock-header">
        <div class="mock-header-inner">
          <p class="mock-eyebrow">{eyebrow}</p>
          <h1 class="mock-title">{name}</h1>
          <p class="mock-lede">{lede}</p>
          <nav class="mock-nav" aria-label="Mockup directions">
            <a href="/mockups">Index</a>
            {
              ROUND_3.map((d) => (
                <a href={`/mockups/${d.id}`} aria-current={d.id === variant ? 'page' : undefined}>
                  {d.label}
                </a>
              ))
            }
            <span class="mock-nav-sep">Earlier</span>
            {
              [...ROUND_2, ...ROUND_1].map((d) => (
                <a href={`/mockups/${d.id}`} aria-current={d.id === variant ? 'page' : undefined}>
                  {d.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <slot />

      {
        round === '2' && (
          <div class="palette-bar" role="group" aria-label="Texture strength">
            <span>Texture</span>
            {['none', 'subtle', 'medium', 'strong'].map((t) => (
              <button type="button" data-texture-btn={t} aria-pressed={String(t === texture)}>
                {t}
              </button>
            ))}
          </div>
        )
      }

      {
        round === '3' && (
          <div class="palette-bar" role="group" aria-label="Year highlight palette">
            <span>Year colour</span>
            {YEAR_PALETTES.map((p) => (
              <button
                type="button"
                data-yearpalette-btn={p.id}
                aria-pressed={String(p.id === yearPalette)}
              >
                {p.label}
              </button>
            ))}
          </div>
        )
      }
    </div>

    {
      round === '2' && (
        <script>
          {/* Mockup-only control; scales each direction's own texture base. */}
          const buttons = document.querySelectorAll('[data-texture-btn]');
          for (const btn of buttons) {
            btn.addEventListener('click', () => {
              document.body.dataset.texture = btn.dataset.textureBtn;
              for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
            });
          }
        </script>
      )
    }

    {
      round === '3' && (
        <script>
          {/* Mockup-only control; swaps the year-highlight scheme. */}
          const buttons = document.querySelectorAll('[data-yearpalette-btn]');
          for (const btn of buttons) {
            btn.addEventListener('click', () => {
              document.body.dataset.yearpalette = btn.dataset.yearpaletteBtn;
              for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
            });
          }
        </script>
      )
    }
  </body>
</html>
