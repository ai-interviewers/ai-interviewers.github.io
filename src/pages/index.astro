---
import BaseLayout from '../layouts/BaseLayout.astro';
import YearChart from '../components/YearChart.astro';
import { BENCHMARK, SITE } from '../consts';
import { getPapers } from '../lib/papers';

const papers = await getPapers();
---

<BaseLayout>
  <section class="mx-auto max-w-3xl px-5 py-20">
    <h1 class="text-4xl font-light tracking-tight sm:text-5xl" style="letter-spacing: -0.015em">
      {SITE.tagline}
    </h1>
    <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-ink-muted)">
      Qualitative interviews surface the reasoning behind people's answers, but they are slow and
      expensive to run at scale. A growing body of work asks whether AI systems can conduct those
      interviews — autonomously or alongside a human researcher — and how well the resulting data
      holds up. This site tracks that literature and hosts {BENCHMARK.name}, a benchmark for
      evaluating AI interviewers directly.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/papers"
        class="rounded px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
        style="background: var(--color-accent)"
      >
        Browse {papers.length} {papers.length === 1 ? 'paper' : 'papers'}
      </a>
      <a
        href="/benchmark"
        class="rounded border px-4 py-2 text-sm font-medium transition-colors hover:opacity-70"
        style="border-color: var(--color-rule)"
      >
        {BENCHMARK.name}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20">
    <h2 class="text-lg font-medium">Papers per year</h2>
    <p class="mt-1 text-sm" style="color: var(--color-ink-muted)">
      Segmented by autonomy. Click a segment to see those papers.
    </p>
    <div class="mt-6">
      <YearChart papers={papers} segmentBy="autonomy" height={180} linkTo="/papers" />
    </div>
  </section>
</BaseLayout>
