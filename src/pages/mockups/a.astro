---
import MockLayout from '../../layouts/MockLayout.astro';
import Explorer from '../../components/mock/Explorer.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
---

<MockLayout
  variant="a"
  name="AI Interviewers"
  eyebrow="Direction A · Academic archive"
  lede="Serif throughout, warm paper tone, hairline rules, citation-forward. Reads like a well-kept annotated bibliography; signals scholarly credibility over product polish. A single dense column rather than a grid — this is a reading list."
>
  <Explorer papers={papers} variant="a" chartPosition="side" segmentBy="autonomy" />
</MockLayout>
