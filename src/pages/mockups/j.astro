---
import MockLayout from '../../layouts/MockLayout.astro';
import Explorer from '../../components/mock/Explorer.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
---

<MockLayout
  variant="j"
  yearPalette="amber"
  name="AI Interviewers"
  eyebrow="Round 3 · J · Matched to your personal site"
  lede="Identical structure to I, restyled to jonathanivey.github.io: Roboto throughout, pure white ground, black ink, #0076df links, and the light-weight display headings your site uses. Included so you can see whether the two sites should read as siblings."
>
  <Explorer papers={papers} variant="j" chartPosition="none" />
</MockLayout>
