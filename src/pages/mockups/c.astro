---
import MockLayout from '../../layouts/MockLayout.astro';
import Explorer from '../../components/mock/Explorer.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
---

<MockLayout
  variant="c"
  name="AI Interviewers"
  eyebrow="Direction C · Data-forward"
  lede="The chart is promoted to the top as the primary navigation device. Compact rows, monospace metadata, short codes instead of words, high contrast. Feels like a dataset explorer — leans into the benchmark half of the site's identity."
>
  <Explorer papers={papers} variant="c" chartPosition="top" segmentBy="type" />
</MockLayout>
