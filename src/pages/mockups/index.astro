---
import MockLayout from '../../layouts/MockLayout.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
const withThumb = papers.filter((p) => p.data.thumbnail).length;

const ROUND_2 = [
  {
    id: 'e',
    name: 'Index card',
    texture: 'Fine paper fibre',
    highlight: 'On the year',
    type: 'Inter + Space Mono',
  },
  {
    id: 'f',
    name: 'Ledger',
    texture: 'Legal-pad ruling + fibre',
    highlight: 'On the venue',
    type: 'DM Sans + Space Mono',
  },
  {
    id: 'g',
    name: 'Manuscript',
    texture: 'Coarse grain',
    highlight: 'Sweeps the title on hover',
    type: 'Source Serif + Space Mono',
  },
  {
    id: 'h',
    name: 'Warm minimal',
    texture: 'None (adjustable)',
    highlight: 'Marker underline',
    type: 'Inter + JetBrains Mono',
  },
];
---

<MockLayout
  variant="i"
  name="Round 3"
  eyebrow="Style directions · two themes, four year-colour schemes"
  lede="E's structure on lighter stock with no texture, plus every content change you asked for: abstracts behind an expander, all authors listed, the whole card opening in a new tab, and venue casing that follows the data so acronyms stay capitalised while Preprint does not shout."
>
  <div class="explorer">
    <div
      style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr))"
    >
      <a href="/mockups/i" style="display:block; padding:1.1rem; background:var(--color-panel); border:1px solid var(--color-rule); text-decoration:none; color:inherit">
        <p class="mock-eyebrow" style="margin-bottom:.35rem">Direction I</p>
        <h2 style="margin:0; font-family:var(--font-display); font-size:1.1rem">Light index card</h2>
        <p style="margin:.6rem 0 0; font-size:.8rem; line-height:1.55; color:var(--color-ink-muted)">
          The consolidated candidate. Inter + Space Mono on warm-white stock, no texture,
          highlighter on the year.
        </p>
      </a>
      <a href="/mockups/j" style="display:block; padding:1.1rem; background:var(--color-panel); border:1px solid var(--color-rule); text-decoration:none; color:inherit">
        <p class="mock-eyebrow" style="margin-bottom:.35rem">Direction J</p>
        <h2 style="margin:0; font-family:var(--font-display); font-size:1.1rem">Personal site</h2>
        <p style="margin:.6rem 0 0; font-size:.8rem; line-height:1.55; color:var(--color-ink-muted)">
          Same structure in your own visual language — Roboto, white, black ink,
          #0076df links, light display weights.
        </p>
      </a>
    </div>

    <h2 style="margin:2.5rem 0 .75rem; font-family:var(--font-display); font-size:1rem">Round 2 — superseded, kept for reference</h2>
    <div
      style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fill,minmax(min(100%,15rem),1fr))"
    >
      {
        ROUND_2.map((d) => (
          <a
            href={`/mockups/${d.id}`}
            style="display:block; padding:1.1rem; background:var(--color-panel); border:1px solid var(--color-rule); text-decoration:none; color:inherit"
          >
            <p class="mock-eyebrow" style="margin-bottom:.35rem">Direction {d.id.toUpperCase()}</p>
            <h2 style="margin:0; font-family:var(--font-display); font-size:1.1rem">{d.name}</h2>
            <dl style="margin:.7rem 0 0; font-size:.76rem; line-height:1.5; color:var(--color-ink-muted)">
              <div>
                <dt style="display:inline; font-weight:600">Texture:</dt>
                <dd style="display:inline; margin:0">{d.texture}</dd>
              </div>
              <div>
                <dt style="display:inline; font-weight:600">Highlighter:</dt>
                <dd style="display:inline; margin:0">{d.highlight}</dd>
              </div>
              <div>
                <dt style="display:inline; font-weight:600">Type:</dt>
                <dd style="display:inline; margin:0">{d.type}</dd>
              </div>
            </dl>
          </a>
        ))
      }
    </div>

    <p class="round-note">
      <strong>Year colour.</strong> Both Round 3 pages carry a control bottom-right with four
      schemes. <em>Amber ramp</em> and <em>Cool→warm</em> encode recency — older papers read pale or
      cold, newer ones saturated or warm — so the colour carries information. <em>Marker pack</em> is
      a box of highlighters: livelier, but the colours mean nothing. <em>Single</em> is the control.
      Because the year is also written as text, none of these rely on colour alone to convey it.
    </p>

    <p class="round-note">
      Data: {papers.length} papers, {withThumb} with PDF thumbnails. The {papers.length - withThumb}
      without an openly reachable PDF fall back to a typographic card — worth checking how those sit
      in the grid, since they are not going away.
    </p>

    <p class="round-note">
      Round 1 (A–D) is still linked in the nav above for reference. D's graph-paper ground and neon
      palette are gone; what carried over is the venue in the top-right corner, the dashed rules in
      F, and the highlighter — now yellow across all four.
    </p>
  </div>
</MockLayout>
