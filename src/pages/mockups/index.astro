---
import MockLayout from '../../layouts/MockLayout.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
const withThumb = papers.filter((p) => p.data.thumbnail).length;

const ROUND_2 = [
  {
    id: 'e',
    name: 'Index card',
    texture: 'Fine paper fibre',
    highlight: 'On the year',
    type: 'Inter + Space Mono',
  },
  {
    id: 'f',
    name: 'Ledger',
    texture: 'Legal-pad ruling + fibre',
    highlight: 'On the venue',
    type: 'DM Sans + Space Mono',
  },
  {
    id: 'g',
    name: 'Manuscript',
    texture: 'Coarse grain',
    highlight: 'Sweeps the title on hover',
    type: 'Source Serif + Space Mono',
  },
  {
    id: 'h',
    name: 'Warm minimal',
    texture: 'None (adjustable)',
    highlight: 'Marker underline',
    type: 'Inter + JetBrains Mono',
  },
];
---

<MockLayout
  variant="e"
  texture="subtle"
  name="Round 2"
  eyebrow="Style directions · pick one, or mix"
  lede="Four treatments over one shared card. Every one is built on direction C's compact base, drops the papers-per-year chart, adds thumbnails to tile view, puts the venue top-right, and carries title / author / year / venue in both tile and list view. No tags on the cards — those are filters only."
>
  <div class="explorer">
    <div
      style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fill,minmax(min(100%,15rem),1fr))"
    >
      {
        ROUND_2.map((d) => (
          <a
            href={`/mockups/${d.id}`}
            style="display:block; padding:1.1rem; background:var(--color-panel); border:1px solid var(--color-rule); text-decoration:none; color:inherit"
          >
            <p class="mock-eyebrow" style="margin-bottom:.35rem">Direction {d.id.toUpperCase()}</p>
            <h2 style="margin:0; font-family:var(--font-display); font-size:1.1rem">{d.name}</h2>
            <dl style="margin:.7rem 0 0; font-size:.76rem; line-height:1.5; color:var(--color-ink-muted)">
              <div>
                <dt style="display:inline; font-weight:600">Texture:</dt>
                <dd style="display:inline; margin:0">{d.texture}</dd>
              </div>
              <div>
                <dt style="display:inline; font-weight:600">Highlighter:</dt>
                <dd style="display:inline; margin:0">{d.highlight}</dd>
              </div>
              <div>
                <dt style="display:inline; font-weight:600">Type:</dt>
                <dd style="display:inline; margin:0">{d.type}</dd>
              </div>
            </dl>
          </a>
        ))
      }
    </div>

    <p class="round-note">
      Each Round 2 page has a <strong>Texture</strong> control bottom-right — none / subtle / medium
      / strong. Texture strength is the one thing that is hard to specify in the abstract, so dial it
      on real content and tell me where it should sit. H starts at none deliberately, as the control:
      it is there to test whether the stationery treatment is earning its keep.
    </p>

    <p class="round-note">
      Data: {papers.length} papers, {withThumb} with PDF thumbnails. The {papers.length - withThumb}
      without an openly reachable PDF fall back to a typographic card — worth checking how those sit
      in the grid, since they are not going away.
    </p>

    <p class="round-note">
      Round 1 (A–D) is still linked in the nav above for reference. D's graph-paper ground and neon
      palette are gone; what carried over is the venue in the top-right corner, the dashed rules in
      F, and the highlighter — now yellow across all four.
    </p>
  </div>
</MockLayout>
