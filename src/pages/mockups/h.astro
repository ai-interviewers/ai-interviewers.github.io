---
import MockLayout from '../../layouts/MockLayout.astro';
import Explorer from '../../components/mock/Explorer.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
---

<MockLayout variant="h" texture="none" name="AI Interviewers" eyebrow="Round 2 · H · Warm minimal" lede="The control. Same structure, warm off-white, no texture at all, and the highlighter reduced to a thick marker underline beneath each title. Included so you can judge whether the stationery treatment is earning its keep.">
  <Explorer papers={papers} variant="h" chartPosition="none" />
  <div class="explorer" style="padding-top:0">
    <p class="round-note">Texture: none. Highlighter: marker underline under the title. Type: Inter + JetBrains Mono. Softer corners, closest to Round 1's C.</p>
  </div>
</MockLayout>
