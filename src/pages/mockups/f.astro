---
import MockLayout from '../../layouts/MockLayout.astro';
import Explorer from '../../components/mock/Explorer.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
---

<MockLayout variant="f" name="AI Interviewers" eyebrow="Round 2 · F · Ledger" lede="Legal-pad ruling behind the page with a hint of fibre, and dashed rules carried over from the transcript direction. The highlighter marks the venue in the top-right corner.">
  <Explorer papers={papers} variant="f" chartPosition="none" />
  <div class="explorer" style="padding-top:0">
    <p class="round-note">Texture: ruled lines plus fibre. Highlighter: on the venue. Type: DM Sans + Space Mono. Dashed borders throughout.</p>
  </div>
</MockLayout>
