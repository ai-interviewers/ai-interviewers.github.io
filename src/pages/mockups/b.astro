---
import MockLayout from '../../layouts/MockLayout.astro';
import Explorer from '../../components/mock/Explorer.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
---

<MockLayout
  variant="b"
  name="AI Interviewers"
  eyebrow="Direction B · Modern research lab"
  lede="Geometric sans, generous whitespace, soft-shadowed cards with the PDF thumbnail up top, pill chips, one strong accent. The familiar arXiv-adjacent tool-site look — friendliest to visitors from outside academia."
>
  <Explorer papers={papers} variant="b" chartPosition="side" segmentBy="autonomy" />
</MockLayout>
